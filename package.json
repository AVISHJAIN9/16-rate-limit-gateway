{
  "name": "16-rate-limit-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p apps/gateway/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:blackbox": "npx tsx scripts/blackbox.ts",
    "test:p0": "vitest run packages/core packages/oracle packages/store-memory packages/store-redis",
    "test:p1": "vitest run tests/p1-gateway-e2e.test.ts",
    "test:resilience": "vitest run tests/resilience.spec.ts",
    "smoke": "vitest run tests/p1-gateway-e2e.test.ts tests/smoke.test.ts",
    "bench": "npx tsx scripts/bench.mjs",
    "check:features": "node scripts/check-features-consistency.mjs",
    "gateway": "node apps/gateway/dist/main.js",
    "build:web": "npm run --workspace=@rlgw/web build",
    "local:up": "npx tsx scripts/dev-stack.ts up",
    "local:down": "npx tsx scripts/dev-stack.ts down",
    "local:verify": "npx tsx scripts/dev-stack.ts verify",
    "seed:dev": "npx tsx scripts/seed-dev.ts",
    "traffic:demo": "npx tsx scripts/demo-traffic.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "fast-check": "^4.10.2",
    "hdr-histogram-js": "^3.0.1",
    "ioredis": "^5.6.1",
    "jose": "^6.2.13",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "supertest": "^7.3.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8",
    "vitepress": "^1.6.3",
    "mermaid": "^11.4.1",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}